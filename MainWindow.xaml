<Window x:Class="Lab8_Var9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Var9"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border CornerRadius="25"
            BorderBrush="#55FFFFFF"
            BorderThickness="3"
            Background="#22000000">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Background="#33000000" Height="40">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                     >

                    <Button Width="28" Height="28" Background="#44FFFFFF"
                            Click="Minimize_Click"
                            ToolTip="Згорнути">
                        <TextBlock Text="–"
                                   FontSize="20"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <Button Width="28" Height="28" Background="#44FF4444"
                            Click="Close_Click"
                            Margin="5 0 0 0"
                            ToolTip="Закрити">
                        <TextBlock Text="×"
                                   FontSize="18"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                </StackPanel>
            </DockPanel>

            <Canvas x:Name="Scene"
                    Grid.Row="1"
                    Background="Transparent"
                    ClipToBounds="True">

                <Ellipse Width="80" Height="80"
                         Fill="Red">
                    <Ellipse.RenderTransform>
                        <MatrixTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Rectangle Width="120" Height="60"
                           Fill="DodgerBlue">
                    <Rectangle.RenderTransform>
                        <MatrixTransform/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <Polygon Fill="LimeGreen"
                         Points="0,60 40,0 80,60">
                    <Polygon.RenderTransform>
                        <MatrixTransform/>
                    </Polygon.RenderTransform>
                </Polygon>

                <Path Fill="Orange"
                      Data="M 10,30 L 50,0 L 90,30 L 50,60 Z">
                    <Path.RenderTransform>
                        <MatrixTransform/>
                    </Path.RenderTransform>
                </Path>

            </Canvas>

        </Grid>
    </Border>
</Window>
